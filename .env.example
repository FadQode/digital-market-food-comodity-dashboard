# Use either DATABASE_URL or the individual DB_* variables below.
# DATABASE_URL=postgresql://user:password@localhost:5432/food_prices

DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_prices
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Required for the Tokopedia Apify job.
APIFY_TOKOPEDIA_TOKEN=change-me

# Optional scraper settings.
SCRAPE_JOBS=tokopedia,bmkg-latest-earthquake,bmkg-recent-earthquakes
SCRAPE_QUERY=beras
SCRAPE_CITY=surabaya
# Required only when SCRAPE_JOBS includes bmkg-weather.
BMKG_ADM4=
