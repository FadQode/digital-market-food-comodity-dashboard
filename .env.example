# Use either DATABASE_URL or the individual DB_* variables below.
# DATABASE_URL=postgresql://user:password@localhost:5432/food_prices

DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_prices
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Paid marketplace credentials. Keep these values out of source control.
TOKOPEDIA_APIFY_KEY=change-me
SHOPEE_APIFY_KEY=change-me

# Actor defaults are selected for pay-per-result pricing and can be overridden.
TOKOPEDIA_APIFY_ACTOR=fatihtahta~tokopedia-scraper
SHOPEE_APIFY_ACTOR=pumpkin_jingo~shopee-scraper-id

# Optional scraper settings.
SCRAPE_JOBS=bmkg-latest-earthquake,bmkg-recent-earthquakes
SCRAPE_QUERY="beras 5 kg"
SCRAPE_CITY=surabaya
ALLOW_PAID_APIS=false
MARKETPLACE_MAX_ITEMS=20
APIFY_MAX_CHARGE_USD=0.07
# Relative to ingestion/scraper-go when using run_scraper.sh.
DATA_DIR=../../data/raw
# Required only when SCRAPE_JOBS includes bmkg-weather.
BMKG_ADM4=
